# Copy to .env.testing for local PHPUnit runs.
# phpunit.xml also supplies defaults; this file is for overrides.

APP_ENV=testing
APP_DEBUG=true
APP_KEY=base64:dGVzdGluZ2tleXRlc3RpbmdreXl0ZXN0aW5na2V5dGVzdA==

DB_CONNECTION=testing

TEST_DB_HOST=127.0.0.1
TEST_DB_DATABASE=testing_timegrid
TEST_DB_USERNAME=testing_timegrid
TEST_DB_PASSWORD=testing_timegrid

CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_DRIVER=sync
MAIL_DRIVER=log
