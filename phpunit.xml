<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="bootstrap/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         beStrictAboutOutputDuringTests="false">
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/unit/</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory suffix="Test.php">./tests/integration/</directory>
        </testsuite>
        <testsuite name="Acceptance">
            <directory suffix="Test.php">./tests/acceptance/compliance/</directory>
            <directory suffix="Test.php">./tests/acceptance/scenarios/</directory>
            <directory suffix="Test.php">./tests/acceptance/commands/</directory>
            <directory suffix="Test.php">./tests/acceptance/emails/</directory>
        </testsuite>
        <testsuite name="Contracts">
            <directory suffix="Test.php">./tests/contracts/</directory>
        </testsuite>
        <testsuite name="Characterization">
            <directory suffix="Test.php">./tests/characterization/</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_URL" value="http://127.0.0.1:8000"/>
        <env name="APP_LOG" value="syslog"/>
        <env name="DB_CONNECTION" value="testing"/>
        <env name="TEST_DB_HOST" value="127.0.0.1"/>
        <env name="TEST_DB_DATABASE" value="testing_timegrid"/>
        <env name="TEST_DB_USERNAME" value="testing_timegrid"/>
        <env name="TEST_DB_PASSWORD" value="testing_timegrid"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_DRIVER" value="sync"/>
        <env name="MAIL_DRIVER" value="log"/>
    </php>
    <source>
        <include>
            <directory suffix=".php">app/</directory>
        </include>
        <exclude>
            <file>./app/Http/routes.php</file>
        </exclude>
    </source>
</phpunit>
