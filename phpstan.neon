# WO-007 — PHPStan level 3 gate (transitional scope on Laravel 5.3).
# Full app/ + database/ + routes/ clean wait for interpreter raise (WO-015) and hops.

parameters:
    level: 3
    paths:
        - app/Console/Commands/SendBusinessReport.php
        - app/Console/Commands/AutopublishBusinessVacancies.php
        - app/Factories
    ignoreErrors:
        # Laravel helpers / Eloquent dynamics without laravel-phpstan extension on L5.3.
        -
            message: '#Function factory not found\.#'
            path: app/Factories/*
        -
            message: '#Function factory invoked with \d+ parameter#'
            path: app/Factories/*
        -
            message: '#Function bcrypt not found\.#'
            path: app/Factories/*
        -
            message: '#Function str_slug not found\.#'
            path: app/Factories/*
        -
            message: '#Call to an undefined static method Timegridio\\Concierge\\Models\\Business::findOrFail\(\)\.#'
            path: app/Console/Commands/*
        -
            message: '#Call to an undefined method Illuminate\\Database\\Eloquent\\Relations\\HasMany::#'
            path: app/Console/Commands/*
        -
            message: '#Call to an undefined static method Illuminate\\Support\\Facades\\Storage::#'
            path: app/Console/Commands/*
        -
            message: '#Call to an undefined method Illuminate\\Contracts\\Filesystem\\Filesystem::#'
            path: app/Console/Commands/*
        -
            message: '#Property App\\Console\\Commands\\.+::\$concierge#'
            path: app/Console/Commands/*
        -
            message: '#Method App\\Console\\Commands\\.+::sendBusinessReport\(\) with return type void returns#'
            path: app/Console/Commands/*
        -
            message: '#Method App\\Console\\Commands\\.+::publishVacancies\(\) with return type void returns#'
            path: app/Console/Commands/*
        -
            message: '#Call to method .+ on an unknown class App\\Console\\Commands\\Timegridio#'
            path: app/Console/Commands/*
    reportUnmatchedIgnoredErrors: false
